        local function setV(v, save)
            v = math.clamp(math.floor(v*mult+0.5)/mult, min, max)
            Config[key] = v
            local f = (v - min) / (max - min)
            txt.Text = tostring(v); fill.Size = UDim2.fromScale(f,1); knob.Position = UDim2.fromScale(f,0.5)
