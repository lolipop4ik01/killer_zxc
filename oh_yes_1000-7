local function stickBehind(hrp, murd)
    local mHRP = murd.Character and murd.Character:FindFirstChild("HumanoidRootPart")
    if not mHRP then return end
    local behind = mHRP.Position - mHRP.CFrame.LookVector * Config.BehindOffset
    hrp.CFrame = CFrame.lookAt(behind, mHRP.Position)
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
end

