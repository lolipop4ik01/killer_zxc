local function blacklistAdd(coin) table.insert(FarmState.blacklist, { coin = coin, expiresAt = tick() + 10 }) end
local function blacklistCheck(coin)
    local now = tick()
    for i = #FarmState.blacklist, 1, -1 do
        local b = FarmState.blacklist[i]
        if now > b.expiresAt then table.remove(FarmState.blacklist, i)
        elseif b.coin == coin then return true end
    end
    return false
end

