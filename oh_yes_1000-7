local function stripOne(d)
    pcall(function()
        if d:IsA("MeshPart") then d.TextureID = ""; d.Material = Enum.Material.SmoothPlastic
        elseif d:IsA("Part") or d:IsA("WedgePart") or d:IsA("TrussPart") or d:IsA("CornerWedgePart") then d.Material = Enum.Material.SmoothPlastic
        elseif d:IsA("SpecialMesh") then d.TextureId = ""; d.MeshId = ""
        elseif d:IsA("SurfaceAppearance") then d.ColorMap=""; d.NormalMap=""; d.RoughnessMap=""; d.MetalnessMap=""
        elseif d:IsA("Decal") or d:IsA("Texture") then d.Texture = ""
        elseif d:IsA("ImageLabel") then d.Image = ""
        elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then d.Enabled = false
        elseif d:IsA("Explosion") then d.Visible = false
        end
    end)
end
local function aggressiveStrip() for _, d in ipairs(WS:GetDescendants()) do stripOne(d) end end
local function applyLighting()
