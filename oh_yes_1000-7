local ReconnectState = { pending = false, lastError = nil, lastAttempt = 0, cooldown = 8 }

local function getServerList()
    local ok, result = pcall(function()
        local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100", game.PlaceId)
        local raw = game:HttpGet(url)
        return HttpService:JSONDecode(raw)
    end)
    if ok and result and result.data then return result.data end
    return {}
end

local function doReconnect(forceHop)
    if ReconnectState.pending and tick() - ReconnectState.lastAttempt < ReconnectState.cooldown then return end
    ReconnectState.pending = true
    ReconnectState.lastAttempt = tick()

    -- запоминаем сервер, С КОТОРОГО уходим, чтобы детектить возврат
    if game.JobId and game.JobId ~= "" then
        Config.lastTeleportFromJobId = game.JobId
        Config.lastTeleportAt = tick()
    end

    if forceHop and game.JobId and game.JobId ~= "" then
        if not Config.serverBlacklist then Config.serverBlacklist = {} end
        Config.serverBlacklist[game.JobId] = tick() + 300
    end
    saveConfig()

    task.spawn(function()
        task.wait(Config.ReconnectDelay or 5)
        task.wait(3)

        local attempts = 0
        local maxAttempts = 3
        local lastFailedServer = nil

        local function attemptHop()
            if attempts >= maxAttempts then
                ReconnectState.pending = false
                pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
                return
            end
            attempts = attempts + 1

            local serverId, players
            if forceHop and Config.HopOnError then
                local servers = getServerList()
                local now = tick()
                local candidates = {}
                local targetCount = Config.HopSearchMaxPlayers or 7

                for _, s in ipairs(servers) do
                    if s.id ~= game.JobId and s.id ~= lastFailedServer and s.playing <= targetCount and s.playing < s.maxPlayers then
                        local blk = Config.serverBlacklist and Config.serverBlacklist[s.id]
                        if not blk or now > blk then table.insert(candidates, s) end
                    end
                end

                if #candidates > 0 then
                    local selected = candidates[math.random(1, #candidates)]
                    serverId = selected.id; players = selected.playing
                else
                    local best, bestCount = nil, math.huge
                    for _, s in ipairs(servers) do
                        if s.id ~= game.JobId and s.id ~= lastFailedServer and s.playing < s.maxPlayers then
                            local blk = Config.serverBlacklist and Config.serverBlacklist[s.id]
                            if not blk or now > blk then
                                local count = tonumber(s.playing) or math.huge
                                if count < bestCount then best, bestCount = s.id, count end
                            end
                        end
                    end
                    serverId, players = best, bestCount
                end
            end

            if serverId then
                lastFailedServer = serverId
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, LP) end)
            else
                ReconnectState.pending = false
                pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
                return
            end
        end

        local conn
        conn = TeleportService.TeleportInitFailed:Connect(function(player, teleportResult, errorMessage)
            if player ~= LP then return end
            if lastFailedServer then
                if not Config.serverBlacklist then Config.serverBlacklist = {} end
                Config.serverBlacklist[lastFailedServer] = tick() + 600
            end
            if conn then conn:Disconnect() end
            task.wait(3)
            if lastFailedServer == game.JobId then
                pcall(function() TeleportService:Teleport(game.PlaceId, LP) end)
            else
                attemptHop()
            end
        end)
        attemptHop()
    end)
end

GuiService.ErrorMessageChanged:Connect(function(msg)
    if not msg or msg == "" then return end
    ReconnectState.lastError = msg
