end)
LogService.MessageOut:Connect(function(msg, msgType)
    if msgType ~= Enum.MessageType.MessageError then return end
    if not msg or msg == "" then return end
    local lower = msg:lower()
    if lower:find("disconnect") or lower:find("kicked") 
        or lower:find("connection lost") or lower:find("lost connection") then
        doReconnect(Config.HopOnError ~= false)
    end
end)

