local function findGunDrop()
    local gd = WS:FindFirstChild("GunDrop")
    if gd then
        if gd:IsA("BasePart") then return gd end
        if gd:IsA("Model") and gd.PrimaryPart then return gd.PrimaryPart end
        if gd:IsA("Model") then
            local handle = gd:FindFirstChild("Handle", true)
            if handle and handle:IsA("BasePart") then return handle end
        end
        if gd:IsA("Tool") then
            local handle = gd:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return handle end
        end
    end
    for _, obj in ipairs(WS:GetChildren()) do
        if obj:IsA("Tool") and obj.Name == "Gun" then
            local handle = obj:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then return handle end
        end
    end
    return nil
end

local function canSafelyGrab(gunPos)
    local murd = getMurd()
    if not murd or not murd.Character then return true, 999 end
    local mHRP = murd.Character:FindFirstChild("HumanoidRootPart")
    if not mHRP then return true, 999 end
    local d = (mHRP.Position - gunPos).Magnitude
    return d >= Config.GunSafeDist, d
end

local function postFarmStep(hrp)
    local now = tick()
    ensureMovers(hrp)

    -- ФАЗА ОЖИДАНИЯ: сидим в сейв-зоне после промаха
    if FarmState.postWaitUntil > 0 and now < FarmState.postWaitUntil then
        if FarmState.postSavedPos then
            hrp.CFrame = CFrame.new(FarmState.postSavedPos)
        end
        if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
        return
    end

    if hasGun() then
        local m = getMurd()
        if m and m.Character then
            local mHRP = m.Character:FindFirstChild("HumanoidRootPart")
            local mHum = m.Character:FindFirstChildOfClass("Humanoid")
            if mHRP and mHum and mHum.Health > 0 then
                equipGun()

                -- выстрел только если не в кулдауне проверки результата
                if now - FarmState.lastShot > Config.ShotInterval then
                    FarmState.lastShot = now
                    FarmState.postSavedPos = hrp.Position
                    FarmState.postWaitUntil = now + 0.6

                    local behind = mHRP.Position - mHRP.CFrame.LookVector * Config.BehindOffset
                    local shooterChar = m.Character

                    -- телепорт к мардеру + выстрел (в spawn чтобы не блокировать Heartbeat)
                    task.spawn(function()
                        local h = getHRP()
                        if not h then return end
                        h.CFrame = CFrame.lookAt(behind, mHRP.Position)
                        h.AssemblyLinearVelocity = Vector3.zero
                        h.AssemblyAngularVelocity = Vector3.zero
                        shootMurd()
                    end)

                    -- проверка результата через 0.6с
                    task.spawn(function()
                        task.wait(0.6)
                        local mHum2 = shooterChar and shooterChar.Parent and shooterChar:FindFirstChildOfClass("Humanoid")
                        if mHum2 and mHum2.Health > 0 then
                            -- промах: ждём 6 секунд в сейв-зоне
                            FarmState.postWaitUntil = tick() + 6
                            warn(string.format("[POST] miss → back to safe, wait 6s (hp=%.0f)", mHum2.Health))
                        else
                            -- попал: murderer мёртв
                            FarmState.postWaitUntil = 0
                        end
                    end)
                end
                return
            end
        end
        return
    end

    -- нет пушки — пробуем подобрать
    if Config.AutoGrabGun then
        local gd = findGunDrop()
        if gd then
            local safe, dist = canSafelyGrab(gd.Position)
            if safe then
                local delta = gd.Position - hrp.Position
                if delta.Magnitude > 3 then
                    FarmState.bv.Velocity = delta.Unit * Config.FlightSpeed
                    if FarmState.bg then FarmState.bg.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(math.rad(90), 0, 0) end
                else
                    FarmState.bv.Velocity = Vector3.zero
                    fireTouch(gd, charParts())
                end
                return
            else
                FarmState.bv.Velocity = Vector3.zero
                return
            end
        end
    end

    if hasKnife() then
        if Config.ResetIfMurderer and now - FarmState.lastReset > 3 then
            FarmState.lastReset = now
            resetSelf()
        end
        return
    end

    if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
end

local function masterStep()
    local now = tick()
    local hrp = getHRP()
    local hum = getHum()
    if not hrp or not hum or hum.Health <= 0 then return end

    local pos = hrp.Position

    -- === IDLE SWAP (работает независимо от monitorServers) ===
    if Config.AutoFarm and FarmState.running and FarmState.phase ~= "post" then
        local idle = now - (FarmState.lastRealFarmAt or 0)
        if idle > (Config.IdleFarmTimeout or 240) then
            warn(string.format("[IDLE-SWAP] no coins for %.0fs (phase=%s players=%d) → hop", 
                idle, tostring(FarmState.phase), #Players:GetPlayers()))
            if not Config.serverBlacklist then Config.serverBlacklist = {} end
            Config.serverBlacklist[game.JobId] = now + 300
            FarmState.lastHopAt = now
            FarmState.hopStreak = (FarmState.hopStreak or 0) + 1
            FarmState.lastRealFarmAt = now  -- сброс, чтобы не спамить
            doReconnect(true)
            return
        end
    end

    local lobbyPos = findLobbyPos()
    local inLobby = lobbyPos and (pos - lobbyPos).Magnitude < 150

    -- детект телепорта: смена позиции на 200+ студов за кадр = сервер переместил
    local posDelta = (pos - FarmState.lastHRPPos).Magnitude
    if posDelta > 200 and lobbyPos then
        if inLobby then
            FarmState.roundActiveRemote = false
            FarmState.inSafeZone = false
            detachSafeMovers()
            dbg(string.format("[TP] → lobby (Y=%.0f, dist=%.0f)", pos.Y, (pos - lobbyPos).Magnitude))
        else
            FarmState.roundActiveRemote = true
            dbg(string.format("[TP] → map (Y=%.0f, distFromLobby=%.0f)", pos.Y, (pos - lobbyPos).Magnitude))
        end
    end

    local roundActive = (FarmState.roundActiveRemote == true)

    if pos.Y < -4500 then
        resetSelf()
        return
    end

    if FarmState.inSafeZone and FarmState.lockedY 
        and math.abs(pos.Y - FarmState.lockedY) > 80 
        and math.abs(pos.Y - FarmState.lockedY) < 3000 then
        detachSafeMovers()
        FarmState.inSafeZone = false
        setPhase("wait")
    end
    FarmState.lastHRPPos = pos

    -- РЕЖИМ ОЖИДАНИЯ (стоим, не лежим)
    if FarmState.phase == "idle" or FarmState.phase == "wait" then
        hum.PlatformStand = false
        
        if not FarmState.inSafeZone then
            local groundY = findGroundY(pos)
            -- только в раунде (не в лобби), вплотную к полу, не в падении
            if groundY
                and roundActive
                and not inLobby
                and math.abs(pos.Y - groundY) < 50
                and math.abs(hrp.AssemblyLinearVelocity.Y) < 20 then
                FarmState.inSafeZone = true
                FarmState.lockedX = pos.X
                FarmState.lockedZ = pos.Z
                FarmState.lockedY = groundY - Config.SafeDepth
                
                hrp.CFrame = CFrame.new(FarmState.lockedX, FarmState.lockedY, FarmState.lockedZ)
                
                FarmState.safeBp = Instance.new("BodyPosition")
                FarmState.safeBp.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                FarmState.safeBp.P = 50000
                FarmState.safeBp.Position = Vector3.new(FarmState.lockedX, FarmState.lockedY, FarmState.lockedZ)
                FarmState.safeBp.Parent = hrp
            end
        end
        
        if FarmState.safeBp then
            FarmState.safeBp.Position = Vector3.new(FarmState.lockedX, FarmState.lockedY, FarmState.lockedZ)
        end

        local coins = getAllCoins()
        local nearest, dist = getNearestCoin(pos)

        if #coins > 0 and nearest and dist < 2000 
            and math.abs(nearest.Position.Y - pos.Y) < 100 then
            detachSafeMovers()
            FarmState.inSafeZone = false
            setPhase("farm")
            return
        end
        return
    end

    -- РЕЖИМ ФАРМА (лежим на животе, X=90)
    if FarmState.phase == "farm" then
        hum.PlatformStand = true
        
        if Config.PostFarmAuto and FarmState.coinCount >= FarmState.coinLimit then
            if hasGun() then setPhase("post"); detachMovers() 
            else resetSelf(); setPhase("idle") end
            return
        end

        -- ЯВНЫЙ БЛОК ЗАДЕРЖКИ (через lastCollectAt, устойчив к спаму ремоутов)
        if Config.CoinStayTime > 0 and FarmState.lastCollectAt > 0 
            and (now - FarmState.lastCollectAt) < Config.CoinStayTime then
            local target = FarmState.lastCoinPos
            if target then
                local delta = target - pos
                if delta.Magnitude > 1 then
                    ensureMovers(hrp)
                    FarmState.bv.Velocity = delta.Unit * Config.FlightSpeed
                else
                    if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
                end
            else
                if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
            end
            if FarmState.bg then FarmState.bg.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0) end
            return
        end

if Config.AutoGrabGun and not hasGun() then
    local gd = findGunDrop()
            if gd then
                local distToGun = (gd.Position - pos).Magnitude
                local safe, distToMurd = canSafelyGrab(gd.Position)
                if safe and distToGun <= Config.MaxGunDistance and now - FarmState.lastGrabAttempt > 2 then
                    FarmState.lastGrabAttempt = now
                    local savedCFrame = hrp.CFrame
                    hrp.CFrame = gd.CFrame
                    task.wait(0.1)
                    fireTouch(gd, charParts())
                    task.wait(0.1)
                    hrp.CFrame = savedCFrame
                    task.wait(0.1)
                    if hasGun() then equipGun() end
                    return
                end
            end
        end

        ensureMovers(hrp)

if FarmState.currentCoin then
    if not FarmState.currentCoin.Parent or not isCoinLive(FarmState.currentCoin) then
        blacklistAdd(FarmState.currentCoin)
        FarmState.lastCoinPos = FarmState.pendingCoinPos or (pos - Vector3.new(0, Config.CoinOffset, 0))
        FarmState.pendingCoinPos = nil
        FarmState.stayUntil = now + Config.CoinStayTime
        FarmState.currentCoin = nil; FarmState.targetAttempts = 0; FarmState.targetSince = 0
        FarmState.lastCollectAt = now; FarmState.lastCoinAt = now
        FarmState.lastRealFarmAt = now
    elseif now - FarmState.targetSince > 2.0 then
        blacklistAdd(FarmState.currentCoin)
                blacklistAdd(FarmState.currentCoin)
                FarmState.currentCoin = nil; FarmState.targetAttempts = 0; FarmState.targetSince = 0
                if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
                return
            end
        end

if not FarmState.currentCoin or (now - FarmState.lastScan > 0.2) then
    FarmState.lastScan = now
    local nearest = getNearestCoin(hrp.Position)
    if nearest then
        if nearest ~= FarmState.currentCoin then
            FarmState.currentCoin = nearest; FarmState.targetSince = now; FarmState.targetAttempts = 0
            -- Не сбрасываем lastCoinPos, если ещё в задержке
            if now >= FarmState.stayUntil then
                FarmState.lastCoinPos = nil
            end
                end
            else
                FarmState.currentCoin = nil
            end
        end

        local target = FarmState.currentCoin
        if not target then
            if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
            if now - FarmState.lastCollectAt > 5 then setPhase("wait") end
            return
        end

        local goal = target.Position - Vector3.new(0, Config.CoinOffset, 0)
        local delta = goal - pos
        local dist = delta.Magnitude
        
        -- ЛЕЖИМ НА ЖИВОТЕ (X=90)
        if FarmState.bg then FarmState.bg.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(90), 0, 0) end
        
        if dist > 0.5 then
            FarmState.bv.Velocity = delta.Unit * Config.FlightSpeed
        else
            FarmState.bv.Velocity = Vector3.zero
        end
        
if dist < 10 then
    FarmState.pendingCoinPos = target.Position - Vector3.new(0, Config.CoinOffset, 0)
    fireTouch(target, charParts())
    FarmState.targetAttempts = FarmState.targetAttempts + 1
    if not target.Parent or not isCoinLive(target) then
        FarmState.lastCoinPos = FarmState.pendingCoinPos
        FarmState.pendingCoinPos = nil
        FarmState.stayUntil = now + Config.CoinStayTime
                FarmState.currentCoin = nil; FarmState.targetAttempts = 0; FarmState.targetSince = 0
                FarmState.lastCollectAt = now; FarmState.lastCoinAt = now
                if FarmState.bv then FarmState.bv.Velocity = Vector3.zero end
            end
        end
        return
    end

    if FarmState.phase == "post" then
        hum.PlatformStand = false
        if not roundActive then
            detachMovers()
            setPhase("wait")
            return
        end
        postFarmStep(hrp)
        return
    end
end


local function startFarm()
    if FarmState.running then return end
    local hrp = getHRP()
    if not hrp then
        task.spawn(function()
            local deadline = tick() + 60
            while tick() < deadline and getgenv().MM2FarmLoaded do
                task.wait(1)
                if getHRP() and Config.AutoFarm then startFarm(); return end
            end
        end)
        return
    end
    FarmState.running = true
    FarmState.lastHRPPos = hrp.Position
    FarmState.lastTeleportAt = 0

    -- детект возврата на тот же сервер (только если свап был <120 сек назад)
    local swapRecent = Config.lastTeleportAt and Config.lastTeleportAt > 0 
        and (tick() - Config.lastTeleportAt) < 120
    if Config.lastTeleportFromJobId == game.JobId 
        and game.JobId ~= "" 
        and swapRecent then
        warn("[SWAP] returned to SAME server " .. game.JobId .. " — retry in 90s")
        Config.lastTeleportFromJobId = ""
        Config.lastTeleportAt = 0
        saveConfig()
        task.delay(90, function()
            if FarmState.running and Config.AutoFarm then
                FarmState.lastHopAt = 0
                warn("[SWAP] retrying hop after same-server detection")
                doReconnect(true)
            end
        end)
    else
        -- нормальный запуск или успешный свап на новый сервер
        Config.lastTeleportFromJobId = ""
        Config.lastTeleportAt = 0
        saveConfig()
    end
    FarmState.lastCoinAt = tick()
    FarmState.lastHopAt = tick()
    FarmState.lastServerCheck = tick()
    FarmState.inSafeZone = false
    FarmState.lastRealFarmAt = tick()
    setPhase("idle")

    -- ИНИЦИАЛИЗАЦИЯ: где мы прямо сейчас — в лобби или в раунде
    task.spawn(function()
        task.wait(0.5)
        local lobbyPos = findLobbyPos()
        if not lobbyPos then
            warn("[INIT] workspace.Lobby not found — waiting for signals")
            return
        end
        warn(string.format("[INIT] lobby center=(%.0f, %.0f, %.0f)", lobbyPos.X, lobbyPos.Y, lobbyPos.Z))

        local _hrp = getHRP()
        if not _hrp then
            warn("[INIT] no character yet — waiting for spawn")
            return
        end

        local distFromLobby = (_hrp.Position - lobbyPos).Magnitude
        warn(string.format("[INIT] charY=%.0f distFromLobby=%.0f", _hrp.Position.Y, distFromLobby))

        if distFromLobby < 150 then
            FarmState.roundActiveRemote = false
            warn("[INIT] → LOBBY (close to lobby center)")
        else
            FarmState.roundActiveRemote = true
            warn("[INIT] → MAP (far from lobby center, round in progress)")
        end

        FarmState.lastHRPPos = _hrp.Position
    end)
    FarmState.conn = RunService.Heartbeat:Connect(masterStep)

    -- если запустили посреди раунда, RoundStart уже прошёл — узнаём через роль
    if FarmState.roundActiveRemote == nil then
        task.spawn(function()
            task.wait(2)
            if FarmState.roundActiveRemote == nil then
                local role = getMyRole()
                if role and role ~= "None" and role ~= "" then
                    FarmState.roundActiveRemote = true
                    warn("[INIT] role detected: " .. tostring(role) .. " → round in progress")
                elseif hasKnife() or hasGun() then
                    FarmState.roundActiveRemote = true
                    warn("[INIT] knife/gun in inventory → round in progress")
                elseif #getAllCoins() > 0 then
                    FarmState.roundActiveRemote = true
                    warn("[INIT] coins on map → round in progress")
                else
                    warn("[INIT] no role, no weapons, no coins → waiting for RoundStart")
                end
            end
        end)
    end
end
local function stopFarm()
    if not FarmState.running then return end
    FarmState.running = false
    if FarmState.conn then FarmState.conn:Disconnect(); FarmState.conn = nil end
    detachMovers(); detachSafeMovers(); setNoclip(false)
    FarmState.inSafeZone = false
    local hum = getHum(); if hum then hum.PlatformStand = false end
    FarmState.phase = "idle"
end

local function monitorServers()
    local now = tick()

    -- диагностика раз в 30 сек независимо от всего
    if not FarmState.lastIdleWarnAt or now - FarmState.lastIdleWarnAt > 30 then
        FarmState.lastIdleWarnAt = now
        local hum = getHum()
        local idle = now - (FarmState.lastRealFarmAt or 0)
        warn(string.format("[MON] idle=%.0fs/%ds phase=%s run=%s af=%s hp=%s players=%d streak=%d pending=%s",
            idle, Config.IdleFarmTimeout or 240, tostring(FarmState.phase),
            tostring(FarmState.running), tostring(Config.AutoFarm),
            tostring(hum and hum.Health), #Players:GetPlayers(),
            FarmState.hopStreak, tostring(ReconnectState.pending)))
    end

    if now - FarmState.lastServerCheck < 1 then return end
    FarmState.lastServerCheck = now
    if now - FarmState.lastHopAt < 8 then return end

    if now - FarmState.hopStreakResetAt > 120 then FarmState.hopStreak = 0; FarmState.hopStreakResetAt = now end
    if FarmState.hopStreak >= 10 then return end

    -- idle проверка ПЕРВАЯ (до players-count)
    if Config.AutoFarm and FarmState.running then
        local idle = now - (FarmState.lastRealFarmAt or 0)
        if idle > (Config.IdleFarmTimeout or 240) then
            warn(string.format("[IDLE] no coins for %.0fs (phase=%s) → hop", idle, tostring(FarmState.phase)))
            if not Config.serverBlacklist then Config.serverBlacklist = {} end
            Config.serverBlacklist[game.JobId] = now + 300
            FarmState.lastHopAt = now
            FarmState.hopStreak = FarmState.hopStreak + 1
            doReconnect(true)
            return
        end
    end

    -- players-count проверка ВТОРАЯ (только если idle ещё не сработал)
    local count = #Players:GetPlayers()
    if count > Config.HopTriggerPlayers then
        warn(string.format("[PLAYERS] %d > %d → hop", count, Config.HopTriggerPlayers))
        FarmState.lastHopAt = now
        FarmState.hopStreak = FarmState.hopStreak + 1
        doReconnect(true)
        return
    end
end

task.spawn(function()
    warn("[MON] loop started")
    while getgenv().MM2FarmLoaded ~= false do
        task.wait(2)
        local ok, err = pcall(monitorServers)
        if not ok then warn("[MON] error: " .. tostring(err)) end
    end
    warn("[MON] loop ended")
end)

