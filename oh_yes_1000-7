local function saveConfig()
    if not writefile then 
        warn("[SAVE] writefile unavailable in this executor")
        return false 
    end
    local ok, j = pcall(HttpService.JSONEncode, HttpService, Config)
    if not ok then 
        warn("[SAVE] JSONEncode failed: " .. tostring(j))
        return false 
    end
    local ok2, err = pcall(writefile, CONFIG_FILE, j)
    if not ok2 then
        warn("[SAVE] writefile failed: " .. tostring(err) .. " path=" .. tostring(CONFIG_FILE))
    end
    return ok2
end

local function loadConfig()
    if not readfile or not isfile then 
        warn("[LOAD] readfile/isfile unavailable in this executor")
        return 
    end
    if not isfile(CONFIG_FILE) then
        warn("[LOAD] no file at " .. tostring(CONFIG_FILE))
        return
    end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG_FILE)) end)
    if ok and type(d) == "table" then
        local n = 0
        for k, v in pairs(d) do 
            if Config[k] ~= nil then 
                Config[k] = v 
                n = n + 1
            end 
        end
        -- успех молча
    else
        warn("[LOAD] JSONDecode failed: " .. tostring(d))
    end
end
