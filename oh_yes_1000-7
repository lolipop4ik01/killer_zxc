local function isCoinLive(c)
    if not c or not c.Parent then return false end
    if c.CanTouch == false then return false end
    if c:GetAttribute("Taken") or c:GetAttribute("Collected") then return false end
    if not c:FindFirstChild("CoinVisual") then return false end
    if blacklistCheck(c) then return false end
    return true
end
local function getAllCoins()
    local out = {}
    local cc = findCoinContainer()
    if not cc then return out end
    for _, c in ipairs(cc:GetChildren()) do if c:IsA("BasePart") and c.Name == "Coin_Server" and isCoinLive(c) then out[#out+1] = c end end
    return out
end
local function getNearestCoin(fromPos)
    local best, bestD
    for _, c in ipairs(getAllCoins()) do
        local d = (c.Position - fromPos).Magnitude
        if not bestD or d < bestD then best, bestD = c, d end
    end
    return best, bestD
end
