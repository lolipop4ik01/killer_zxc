local function shootMurd()
    pcall(function()
        local m = getMurd()
        if not m or not m.Character then return end
        local mHRP = m.Character:FindFirstChild("HumanoidRootPart")
        if not mHRP then return end
        
        local gun = getGunTool()
        if not gun then return end
        
        local shootEv = gun:FindFirstChild("Shoot")
        if not shootEv then return end
        if not shootEv:IsA("RemoteEvent") then return end
        
        local myHRP = getHRP()
        if not myHRP then return end
        
        local originPos = myHRP.Position + Vector3.new(0, 1, 0)
        local targetPos = mHRP.Position
        
        local A_1 = CFrame.lookAt(originPos, targetPos)
        local A_2 = CFrame.new(targetPos)
        
        shootEv:FireServer(A_1, A_2)
    end)
end

